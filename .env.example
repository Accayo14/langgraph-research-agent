# --- Option 1: OpenRouter (free models) ---
MODEL=openai:qwen/qwen3.8-27b:free
BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=your-openrouter-key-here
FALLBACK_MODELS=openai:nvidia/nemotron-3-super-120b-a12b:free,openai:dots-studio/dots-3-note-preview:free
AUTO_DISCOVER_FREE_MODELS=true

